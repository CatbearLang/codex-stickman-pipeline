# Copy to .env (never commit it) or export in your shell.
# None of these are required for the default path (Codex login + Edge TTS).

# Optional: images.provider=openai-api
OPENAI_API_KEY=
# Optional: voice.provider=elevenlabs
ELEVENLABS_API_KEY=
# Optional: voice.provider=http (name configurable via voice.key_env)
TTS_API_KEY=
# Optional: path to the cross-project image budget ledger
STICKMAN_BUDGET_LEDGER=
